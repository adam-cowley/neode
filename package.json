{
  "name": "neode",
  "version": "1.0.0-next.1",
  "description": "Decorator-based Object Graph Mapper for Neo4j and Cypher-compatible graph databases",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "AGENTS.md",
    "docs/agent",
    "skills"
  ],
  "sideEffects": false,
  "bin": {
    "neode-generate": "./dist/bin/neode-generate.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build && npm run test:unit",
    "prepare": "husky || true && tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:aura": "vitest run --project integration test/integration/aura-smoke.test.ts",
    "test:package": "vitest run --project package",
    "test:types": "npm run typecheck && vitest run --typecheck --project types",
    "test:watch": "vitest",
    "docs:agents": "jiti scripts/generate-agent-docs.ts",
    "bench": "vitest bench --project unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --cache && biome format .",
    "lint:fix": "eslint . --fix --cache && biome format --write .",
    "format": "biome format --write .",
    "check:package": "publint && attw --pack . --profile node16",
    "release": "pnpm build && changeset publish",
    "knip": "knip",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@12.18.0",
  "keywords": [
    "neo4j",
    "ogm",
    "graph",
    "cypher",
    "orm",
    "memgraph",
    "decorators"
  ],
  "author": "Adam Cowley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-cowley/neode.git"
  },
  "bugs": {
    "url": "https://github.com/adam-cowley/neode/issues"
  },
  "homepage": "https://github.com/adam-cowley/neode#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.0.0",
    "@testcontainers/neo4j": "^12.2.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.44.1",
    "neo4j-driver": "^6.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "neo4j-driver": "^6.0.0"
  }
}
