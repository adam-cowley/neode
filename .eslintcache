eType":"787","messageId":"788","endLine":67,"endColumn":42,"suppressions":"789"},{"ruleId":"790","severity":2,"message":"791","line":380,"column":18,"nodeType":"792","messageId":"793","endLine":380,"endColumn":39,"suppressions":"794"},{"ruleId":"746","severity":2,"message":"753","line":11,"column":10,"nodeType":"743","messageId":"749","endLine":11,"endColumn":33,"fix":"795","suppressions":"796"},{"ruleId":"797","severity":2,"message":"798","line":156,"column":53,"nodeType":"743","messageId":"799","endLine":156,"endColumn":65,"suppressions":"800"},{"ruleId":"785","severity":2,"message":"801","line":73,"column":19,"nodeType":"787","messageId":"788","endLine":73,"endColumn":67,"suppressions":"802"},{"ruleId":"785","severity":2,"message":"803","line":444,"column":13,"nodeType":"787","messageId":"788","endLine":444,"endColumn":41,"suppressions":"804"},{"ruleId":"805","severity":2,"message":"806","line":201,"column":16,"nodeType":"807","messageId":"808","endLine":201,"endColumn":17,"suggestions":"809","suppressions":"810"},"@typescript-eslint/no-deprecated","`String` is deprecated. Use `@Property({ type: 'string' })` instead — `@String` shadows the global `String` type.","Identifier","deprecatedWithReason",["811"],"unicorn/name-replacements","The filename `neo4j-connection-provider.ts` should be named `neo4index-connection-provider.ts`. A more descriptive name will do too.","Program","replace",["812"],"The variable `Neo4jTransactionHandle` should be named `Neo4indexTransactionHandle`. A more descriptive name will do too.",["813"],"The variable `Neo4jConnectionProvider` should be named `Neo4indexConnectionProvider`. A more descriptive name will do too.",["814"],"@typescript-eslint/require-await","Async method 'session' has no 'await' expression.","FunctionExpression","missingAwait",["815"],["816"],"Async method 'commit' has no 'await' expression.",["817"],["818"],"Async method 'rollback' has no 'await' expression.",["819"],["820"],"Async method 'edition' has no 'await' expression.",["821"],["822"],"The variable `QueryParams` should be named `QueryParameters`. A more descriptive name will do too.",["823"],"The filename `from-env.ts` should be named `from-environment.ts`. A more descriptive name will do too.",["824"],{"range":"825","text":"826"},["827"],"The variable `EnvConnectionConfig` should be named `EnvironmentConnectionConfig`. A more descriptive name will do too.",["828"],"The variable `envValue` should be named `environmentValue`. A more descriptive name will do too.",{"range":"829","text":"830"},["831"],"The variable `configFromEnv` should be named `configFromEnvironment`. A more descriptive name will do too.",["832"],"The variable `fromEnv` should be named `fromEnvironment`. A more descriptive name will do too.",["833"],"@typescript-eslint/no-unsafe-type-assertion","Unsafe type assertion: type 'Repository<Entity>' is more narrow than the original type.","TSAsExpression","unsafeTypeAssertion",["834"],"@typescript-eslint/no-redundant-type-constituents","\"string\" | \"number\" | \"boolean\" | \"any\" | \"int\" | \"integer\" | \"float\" | \"uuid\" | \"date\" | \"time\" | \"datetime\" | \"localtime\" | \"localdatetime\" | \"point\" | \"duration\" is overridden by string in this union type.","TSTypeReference","literalOverridden",["835"],{"range":"836","text":"837"},["838"],"unicorn/prefer-event-target","Prefer `EventTarget` over `EventEmitter`.","prefer-event-target",["839"],"Unsafe type assertion: type 'new (...arguments_: never[]) => Entity' is more narrow than the original type.",["840"],"Unsafe type assertion: type 'ConstraintType' is more narrow than the original type.",["841"],"@typescript-eslint/no-unnecessary-type-parameters","Type parameter T is used only once in the function signature.","TSTypeParameter","sole",["842"],["843"],{"kind":"844","justification":"845"},{"kind":"844","justification":"846"},{"kind":"844","justification":"846"},{"kind":"844","justification":"846"},{"messageId":"847","fix":"848","desc":"849"},{"kind":"844","justification":"850"},{"messageId":"847","fix":"851","desc":"849"},{"kind":"844","justification":"852"},{"messageId":"847","fix":"853","desc":"849"},{"kind":"844","justification":"854"},{"messageId":"847","fix":"855","desc":"849"},{"kind":"844","justification":"856"},{"kind":"844","justification":"857"},{"kind":"844","justification":"858"},[614,6678],"Neo4jConnectionProvider as Neo4indexConnectionProvider } from './driver/neo4j-connection-provider.js'\nimport { Neode } from './neode.service.js'\n\nexport interface EnvConnectionConfig {\n  uri: string\n  auth: ReturnType<typeof auth.basic> | undefined\n  config: Record<string, unknown>\n  database: string\n  enterprise: boolean\n}\n\nfunction warnIgnoring(environmentVariable: string, reason: string): void {\n  console.warn(`fromEnv: ignoring ${environmentVariable} — ${reason}`)\n}\n\n// The full TrustStrategy union in neo4j-driver 6 (legacy driver 4/5 values\n// such as TRUST_SIGNED_CERTIFICATES are no longer part of it)\nconst TRUST_STRATEGIES = [\n  'TRUST_ALL_CERTIFICATES',\n  'TRUST_CUSTOM_CA_SIGNED_CERTIFICATES',\n  'TRUST_SYSTEM_CA_SIGNED_CERTIFICATES',\n]\n\ntype LogLevel = 'error' | 'warn' | 'info' | 'debug'\n\nconst LOG_LEVELS: Set<string> = new Set<LogLevel>(['error', 'warn', 'info', 'debug'])\n\nfunction isLogLevel(value: string): value is LogLevel {\n  return LOG_LEVELS.has(value)\n}\n\n/**\nAn env var's value, with the empty string treated as unset (the `||`\nfallback semantics fromEnv has always had).\n*/\nfunction envValue(environment: NodeJS.ProcessEnv, key: string): string | undefined {\n  const value = environment[key]\n\n  return value === undefined || value === '' ? undefined : value\n}\n\n/**\nPure process-env → connection mapping used by fromEnv().\n\n`driverConfig` is merged verbatim over the env-derived config — any option\nneo4j.driver accepts can be passed even when no NEO4J_* variable maps to\nit. Explicit values win over env-derived ones; `undefined` entries are\nskipped so a programmatically-built config does not clobber env values.\n\nAudited against the neo4j-driver 6 config surface:\n- `encrypted` / `trust` / `trustedCertificates` still exist, but the legacy\n  `TRUST_SIGNED_CERTIFICATES` value was dropped from `TrustStrategy`\n  (passed through with a warning).\n- `knownHosts` and `loadBalancingStrategy` were removed entirely —\n  warn + ignore.\n- `logging` must be a `{ level, logger }` object; a raw string throws\n  \"Illegal logger function\" at driver construction.\n*/\nexport function configFromEnv(\n  environment: NodeJS.ProcessEnv,\n  driverConfig: Config = {},\n): EnvConnectionConfig {\n  const protocol = envValue(environment, 'NEO4J_PROTOCOL') ?? 'bolt'\n  const host = envValue(environment, 'NEO4J_HOST') ?? 'localhost'\n  const port = envValue(environment, 'NEO4J_PORT') ?? '7687'\n\n  const config: Record<string, unknown> = {}\n\n  const ints: Record<string, string> = {\n    NEO4J_MAX_CONNECTION_POOLSIZE: 'maxConnectionPoolSize',\n    NEO4J_MAX_TRANSACTION_RETRY_TIME: 'maxTransactionRetryTime',\n    NEO4J_MAX_CONNECTION_LIFETIME: 'maxConnectionLifetime',\n    NEO4J_CONNECTION_TIMEOUT: 'connectionTimeout',\n    NEO4J_CONNECTION_ACQUISITION_TIMEOUT: 'connectionAcquisitionTimeout',\n  }\n\n  for (const [setting, key] of Object.entries(ints)) {\n    const raw = environment[setting]\n\n    if (raw !== undefined) {\n      config[key] = Number(raw)\n    }\n  }\n\n  const disableLosslessIntegers = envValue(environment, 'NEO4J_DISABLE_LOSSLESS_INTEGERS')\n\n  if (disableLosslessIntegers !== undefined) {\n    config['disableLosslessIntegers'] = disableLosslessIntegers === 'true'\n  }\n\n  const encryption = envValue(environment, 'NEO4J_ENCRYPTION')\n\n  if (encryption !== undefined) {\n    if (encryption === 'true' || encryption === 'ENCRYPTION_ON') {\n      config['encrypted'] = true\n    } else if (encryption === 'false' || encryption === 'ENCRYPTION_OFF') {\n      config['encrypted'] = false\n    } else {\n      warnIgnoring('NEO4J_ENCRYPTION', `unknown value \"${encryption}\"`)\n    }\n  }\n\n  const trust = envValue(environment, 'NEO4J_TRUST')\n\n  if (trust !== undefined) {\n    if (TRUST_STRATEGIES.includes(trust)) {\n      // A driver 6 trust strategy — pass through untouched\n    } else {\n      console.warn(\n        `fromEnv: NEO4J_TRUST \"${trust}\" is not a driver 6 trust strategy (${TRUST_STRATEGIES.join(', ')}) — passing through as-is`,\n      )\n    }\n\n    config['trust'] = trust\n  }\n\n  const trustedCertificates = envValue(environment, 'NEO4J_TRUSTED_CERTIFICATES')\n\n  if (trustedCertificates !== undefined) {\n    config['trustedCertificates'] = trustedCertificates.split(',')\n  }\n\n  const level = envValue(environment, 'NEO4J_LOGGING_LEVEL')\n\n  if (level !== undefined) {\n    if (isLogLevel(level)) {\n      config['logging'] = logging.console(level)\n    } else {\n      warnIgnoring('NEO4J_LOGGING_LEVEL', `unknown level \"${level}\"`)\n    }\n  }\n\n  // shortcut: removed in neo4j-driver 6 — warn + ignore, upgrade if the driver reintroduces them\n  for (const setting of ['NEO4J_KNOWN_HOSTS', 'NEO4J_LOAD_BALANCING_STRATEGY']) {\n    if (envValue(environment, setting) !== undefined) {\n      warnIgnoring(setting, 'removed in neo4j-driver 6')\n    }\n  }\n\n  const username = envValue(environment, 'NEO4J_USERNAME')\n  const password = envValue(environment, 'NEO4J_PASSWORD')\n\n  return {\n    uri: envValue(environment, 'NEO4J_URI') ?? `${protocol}://${host}:${port}`,\n    auth:\n      username === undefined || password === undefined ? undefined : auth.basic(username, password),\n    config: {\n      ...config,\n      ...Object.fromEntries(\n        Object.entries(driverConfig).filter(([, value]) => value !== undefined),\n      ),\n    },\n    database: envValue(environment, 'NEO4J_DATABASE') ?? 'neo4j',\n    enterprise: environment['NEO4J_ENTERPRISE'] === 'true',\n  }\n}\n\n/**\nLoad a .env file (dotenv does not clobber variables already set in\nprocess.env), map the NEO4J_* variables to a connection config and\nconstruct the neo4j driver. `driverConfig` — anything neo4j.driver\naccepts, e.g. `disableLosslessIntegers: true` — is forwarded verbatim,\nmerged over the env-derived values.\n*/\nexport function fromEnv(driverConfig: Config = {}): Neode {\n  // Load vars from .env — dotenv does not clobber variables that are\n  // already set in process.env\n  configDotenv()\n\n  const {\n    uri,\n    auth: authToken,\n    config,\n    database,\n    enterprise,\n  } = configFromEnv(process.env, driverConfig)\n\n  const driver = createDriver(uri, authToken, config)\n\n  return new Neode(new Neo4indexConnectionProvider",{"kind":"844","justification":"858"},{"kind":"844","justification":"858"},[1697,5841],"environmentValue(environment: NodeJS.ProcessEnv, key: string): string | undefined {\n  const value = environment[key]\n\n  return value === undefined || value === '' ? undefined : value\n}\n\n/**\nPure process-env → connection mapping used by fromEnv().\n\n`driverConfig` is merged verbatim over the env-derived config — any option\nneo4j.driver accepts can be passed even when no NEO4J_* variable maps to\nit. Explicit values win over env-derived ones; `undefined` entries are\nskipped so a programmatically-built config does not clobber env values.\n\nAudited against the neo4j-driver 6 config surface:\n- `encrypted` / `trust` / `trustedCertificates` still exist, but the legacy\n  `TRUST_SIGNED_CERTIFICATES` value was dropped from `TrustStrategy`\n  (passed through with a warning).\n- `knownHosts` and `loadBalancingStrategy` were removed entirely —\n  warn + ignore.\n- `logging` must be a `{ level, logger }` object; a raw string throws\n  \"Illegal logger function\" at driver construction.\n*/\nexport function configFromEnv(\n  environment: NodeJS.ProcessEnv,\n  driverConfig: Config = {},\n): EnvConnectionConfig {\n  const protocol = environmentValue(environment, 'NEO4J_PROTOCOL') ?? 'bolt'\n  const host = environmentValue(environment, 'NEO4J_HOST') ?? 'localhost'\n  const port = environmentValue(environment, 'NEO4J_PORT') ?? '7687'\n\n  const config: Record<string, unknown> = {}\n\n  const ints: Record<string, string> = {\n    NEO4J_MAX_CONNECTION_POOLSIZE: 'maxConnectionPoolSize',\n    NEO4J_MAX_TRANSACTION_RETRY_TIME: 'maxTransactionRetryTime',\n    NEO4J_MAX_CONNECTION_LIFETIME: 'maxConnectionLifetime',\n    NEO4J_CONNECTION_TIMEOUT: 'connectionTimeout',\n    NEO4J_CONNECTION_ACQUISITION_TIMEOUT: 'connectionAcquisitionTimeout',\n  }\n\n  for (const [setting, key] of Object.entries(ints)) {\n    const raw = environment[setting]\n\n    if (raw !== undefined) {\n      config[key] = Number(raw)\n    }\n  }\n\n  const disableLosslessIntegers = environmentValue(environment, 'NEO4J_DISABLE_LOSSLESS_INTEGERS')\n\n  if (disableLosslessIntegers !== undefined) {\n    config['disableLosslessIntegers'] = disableLosslessIntegers === 'true'\n  }\n\n  const encryption = environmentValue(environment, 'NEO4J_ENCRYPTION')\n\n  if (encryption !== undefined) {\n    if (encryption === 'true' || encryption === 'ENCRYPTION_ON') {\n      config['encrypted'] = true\n    } else if (encryption === 'false' || encryption === 'ENCRYPTION_OFF') {\n      config['encrypted'] = false\n    } else {\n      warnIgnoring('NEO4J_ENCRYPTION', `unknown value \"${encryption}\"`)\n    }\n  }\n\n  const trust = environmentValue(environment, 'NEO4J_TRUST')\n\n  if (trust !== undefined) {\n    if (TRUST_STRATEGIES.includes(trust)) {\n      // A driver 6 trust strategy — pass through untouched\n    } else {\n      console.warn(\n        `fromEnv: NEO4J_TRUST \"${trust}\" is not a driver 6 trust strategy (${TRUST_STRATEGIES.join(', ')}) — passing through as-is`,\n      )\n    }\n\n    config['trust'] = trust\n  }\n\n  const trustedCertificates = environmentValue(environment, 'NEO4J_TRUSTED_CERTIFICATES')\n\n  if (trustedCertificates !== undefined) {\n    config['trustedCertificates'] = trustedCertificates.split(',')\n  }\n\n  const level = environmentValue(environment, 'NEO4J_LOGGING_LEVEL')\n\n  if (level !== undefined) {\n    if (isLogLevel(level)) {\n      config['logging'] = logging.console(level)\n    } else {\n      warnIgnoring('NEO4J_LOGGING_LEVEL', `unknown level \"${level}\"`)\n    }\n  }\n\n  // shortcut: removed in neo4j-driver 6 — warn + ignore, upgrade if the driver reintroduces them\n  for (const setting of ['NEO4J_KNOWN_HOSTS', 'NEO4J_LOAD_BALANCING_STRATEGY']) {\n    if (environmentValue(environment, setting) !== undefined) {\n      warnIgnoring(setting, 'removed in neo4j-driver 6')\n    }\n  }\n\n  const username = environmentValue(environment, 'NEO4J_USERNAME')\n  const password = environmentValue(environment, 'NEO4J_PASSWORD')\n\n  return {\n    uri: environmentValue(environment, 'NEO4J_URI') ?? `${protocol}://${host}:${port}`,\n    auth:\n      username === undefined || password === undefined ? undefined : auth.basic(username, password),\n    config: {\n      ...config,\n      ...Object.fromEntries(\n        Object.entries(driverConfig).filter(([, value]) => value !== undefined),\n      ),\n    },\n    database: environmentValue",{"kind":"844","justification":"858"},{"kind":"844","justification":"858"},{"kind":"844","justification":"858"},{"kind":"844","justification":"859"},{"kind":"844","justification":"860"},[582,5845],"Neo4jConnectionProvider as Neo4indexConnectionProvider } from './driver/neo4j-connection-provider.js'\nimport { RelateConnectionProvider } from './driver/relate.js'\nimport type {\n  AccessMode,\n  ConnectionOptions,\n  ConnectionProvider,\n  CypherOptions,\n  GraphRelationship,\n  QueryOutput,\n  QueryParams as QueryParameters,\n  Runner,\n  TransactionHandle,\n} from './driver/types.js'\nimport { elementIdOfEntity } from './element-id.js'\nimport { setDefaultNeode } from './entity-methods.js'\nimport { NeodeError } from './errors/index.js'\nimport { hydrate } from './hydrate.js'\nimport type { EntitySchema } from './meta/entity/entity-schema.js'\nimport { getModel, getModels } from './meta/index.js'\nimport {\n  defineModel,\n  extendModel,\n  getModelByName,\n  unknownDefinitionError,\n} from './meta/map-schema.js'\nimport type { Newable } from './meta/newable.js'\nimport { type Ontology, ontology, ontologyMarkdown } from './meta/ontology.js'\nimport type { RelationshipPropertySchema } from './meta/relationship-property-schema.js'\nimport { resolveRepository } from './meta/repositories.js'\nimport type { SchemaDefinition } from './meta/schema-definition.interface.js'\nimport type { INeode } from './neode.interface.js'\nimport { type RunCypherScriptOptions, runCypherScript } from './ops/index.js'\nimport { hasProjectedProperties } from './projection/index.js'\nimport { ProjectionService } from './projection/projection.service.js'\nimport { Builder } from './query/index.js'\nimport { quote } from './query/quote.js'\nimport type { Repository } from './repository/index.js'\nimport { FactoryBuilder } from './services/factory.service.js'\nimport { type BulkChunk, type BulkOptions, BulkService } from './services/query/bulk.service.js'\nimport { CreateService } from './services/query/create.service.js'\nimport { type DeleteOptions, DeleteService } from './services/query/delete.service.js'\nimport { type DetachResult, DetachService } from './services/query/detach.service.js'\nimport { FindService } from './services/query/find.service.js'\nimport { FindByIdService } from './services/query/find-by-id.service.js'\nimport { GetService, type OrderSpec } from './services/query/get.service.js'\nimport { type KnnMode, knn } from './services/query/knn.service.js'\nimport { getMergeFields, MergeService } from './services/query/merge.service.js'\nimport { rollbackAfterFailure } from './transaction/rollback.js'\nimport {\n  type CursorPage,\n  type CursorPaginateOptions,\n  type OffsetPaginateOptions,\n  type Page,\n  PaginateService,\n} from './services/query/paginate.service.js'\nimport { RelateService } from './services/query/relate.service.js'\nimport { type ScoredEntity, search } from './services/query/search.service.js'\nimport { UpdateService } from './services/query/update.service.js'\nimport { WithinDistanceService } from './services/query/within-distance.service.js'\nimport {\n  type ApplySchemaDiffOptions,\n  applySchemaDrift,\n  formatSchemaDrift,\n  type SchemaDrift,\n  schemaDrift,\n} from './services/schema/drift.service.js'\nimport {\n  type FulltextIndexDefinition,\n  FulltextIndexService,\n} from './services/schema/fulltext.service.js'\nimport {\n  type InspectOptions,\n  inspectSchema,\n  type SchemaInspection,\n} from './services/schema/inspect.service.js'\nimport { type SchemaResult, SchemaService } from './services/schema/schema.service.js'\nimport { type VectorIndexDefinition, VectorIndexService } from './services/schema/vector.service.js'\nimport { constructorOf, isConstructorOf, isRecord } from './services/type-guards.js'\nimport { type BatchStatementError, TransactionError } from './transaction/errors.js'\nimport { TransactionalService } from './transaction/transactional.service.js'\n\n/**\nThe constructor parameter of the embedded Relate provider: the Relate\ndatabase instance (its interface is private to driver/relate.ts, so it is\nreferenced structurally).\n*/\ntype RelateDatabaseValue = ConstructorParameters<typeof RelateConnectionProvider>[0]\n\n/**\nA map-based schema definition as loaded from a model module (withDirectory).\nThe per-key values are validated by defineModel — the guard checks the\nenvelope.\n*/\nfunction isSchemaDefinition(value: unknown): value is SchemaDefinition {\n  return isRecord(value)\n}\n\n/* eslint-disable unicorn/prefer-event-target -- the event emitter is shared with TransactionalService (its constructor takes it and calls on/emit), which an EventTarget adapter would break */\n/**\nThe OGM facade: models, raw queries, transactions, schema management and\nthe event emitter, over a ConnectionProvider (neo4j-driver or the embedded\nRelate engine). Construct via `forDriver` / `forRelate` / `fromEnv`, or\ndirectly with a ConnectionProvider.\n*/\nexport class Neode implements INeode {\n  /**\n  The structural minimum of the embedded Relate database (driver/relate.ts\n  keeps its interface private).\n  */\n  private static isRelateDatabase(value: unknown): value is RelateDatabaseValue {\n    return isRecord(value) && typeof value['connect'] === 'function'\n  }\n\n  /**\n  Create a Neode instance over a neo4j-driver Driver\n  (Neo4j Community / Enterprise, Memgraph, or any Bolt server)\n  */\n  static forDriver(\n    driver: Driver,\n    database?: string,\n    isEnterprise = false,\n    options: ConnectionOptions = {},\n  ): Neode {\n    return new Neode(new Neo4indexConnectionProvider",{"kind":"844","justification":"861"},{"kind":"844","justification":"862"},{"kind":"844","justification":"863"},{"kind":"844","justification":"864"},{"messageId":"865","fix":"866","desc":"867"},{"kind":"844","justification":"868"},"directive","re-exporting the deprecated @String on purpose: the legacy decorator stays exported for compatibility","\"Neo4j\" is the product name (the rule's `j` -> `index` replacement misfires on it), and these are the documented public class names","removeAsync",{"range":"869","text":"870"},"Remove 'async'.","driver session construction is synchronous; kept async so callers await it uniformly",{"range":"871","text":"872"},"the embedded engine commits synchronously; nothing to await",{"range":"873","text":"874"},"the embedded engine rolls back synchronously; nothing to await",{"range":"875","text":"876"},"the embedded engine has no editions and no async call behind this","`QueryParams` is the documented public API name and imported by name in the test suites; renaming is a breaking change","\"Neo4j\" is the product name (the rule's `j` -> `index` replacement misfires on it), and fromEnv / EnvConnectionConfig are the documented public API names","the map erases the entity/repository generic correlation; the lookup above re-establishes it","string subsumes PropertyTypeName by design, so `description?: string` can coexist with the index signature","\"Neo4j\" is the product name (the rule's `j` -> `index` replacement misfires on it)","the event emitter is shared with TransactionalService (its constructor takes it and calls on/emit), which an EventTarget adapter would break","the registry erases the entity/repository generic correlation; the registered-model check above re-establishes it","reporting-only field","replaceUsagesWithConstraint",{"range":"877","text":"878"},"Replace all usages of type parameter with its constraint.","the generic mirrors INeode#delete's signature; the entity type cannot be inferred from anything else in it",[5510,5584],"session(mode: AccessMode, database?: string): DriverSession",[9000,9029],"commit(): void",[9355,9386],"rollback(): void",[11819,11883],"edition(): 'enterprise' | 'community' | 'unknown'",[6577,6590],"(entity: unknown"]