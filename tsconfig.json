{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "ESNext.Decorators"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "noEmit": true,

    // The cookbook scripts import 'neode' the way a consumer does; at type
    // check time that resolves to the source, so the examples rot with the API
    "paths": { "neode": ["./src/index.ts"] },
    // Disambiguates the 'neode' paths resolution against this package's own
    // exports map (TS2209); noEmit, so it never affects emitted output
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    // All type tests — including the migration-guide snippet mirror
    // (test/types/migration-guide-snippets.test-d.ts) — type-check under
    // plain `tsc --noEmit`. NTS-493 repaired the api.test-d.ts assertions
    // to match the real API, so the whole directory passes tsc.
    "test/types/**/*.test-d.ts",
    "examples/cookbook/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
